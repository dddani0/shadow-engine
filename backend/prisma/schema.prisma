generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String     @id @default(cuid())
  title        String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  scenes       Scene[]
  variables    Variable[]
  saveSlots    SaveSlot[]
  startSceneId String?
}

//Project scene
model Scene {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int         @default(0)
  metadata   Json? // background, characters on screen, audio cues
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  saveSlots  SaveSlot[]
  timeline   Timeline? //THis is dumb, but one to one relations in prisma require optionality :O
  components Component[]
}

model Choice {
  id           String      @id @default(cuid())
  actionId     String
  action       Action      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  choiceMenu   ChoiceMenu? @relation(fields: [choiceMenuId], references: [id])
  choiceMenuId String?     @unique
  label        String
  orderIndex   Int         @default(0)
}

//Project timeline
model Timeline {
  id      String   @id @default(cuid())
  scene   Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId String   @unique
  actions Action[]
}

//Component
model Component {
  id         String      @id @default(cuid())
  title      String
  scene      Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId    String
  //Sprite
  sprite     Sprite?
  //Textbox
  textBox    Textbox?
  //Choice menu
  choiceMenu ChoiceMenu?
}

model ChoiceMenu {
  id          String     @id @default(cuid())
  title       String?
  description String?
  component   Component? @relation(fields: [componentId], references: [id])
  componentId String?    @unique
  choices     Choice[]
}

model Sprite {
  id          String     @id @default(cuid())
  path        String
  component   Component? @relation(fields: [componentId], references: [id])
  componentId String?    @unique
}

model Textbox {
  id            String     @id @default(cuid())
  title         String?
  content       String[]
  charPerSecond Int
  component     Component? @relation(fields: [componentId], references: [id])
  componentId   String?    @unique
}

//Action of the timeline
model Action {
  id          String   @id @default(cuid())
  type        String
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId  String
  componentId String?
  choices     Choice[]
}

//Variable of the project
model Variable {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name]) //The combination has to be unique
}

model SaveSlot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId   String
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  slotIndex Int // 1-based slot number
  stateJson String? // snapshot of variables/flags as JSON
  createdAt DateTime @default(now())

  @@unique([projectId, slotIndex])
}
