generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String     @id @default(cuid())
  title        String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  scenes       Scene[]
  toTimelineId String?    @unique
  timeline     Timeline?  @relation("ProjectTimeline")
  variables    Variable[]
  saveSlots    SaveSlot[]
}

//Project scene
model Scene {
  id                    String                 @id @default(cuid())
  projectId             String
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String?
  orderIndex            Int                    @default(0)
  metadata              Json? // background, characters on screen, audio cues
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  choicesFrom           Choice[]               @relation("FromScene")
  choicesTo             Choice[]               @relation("ToScene")
  saveSlots             SaveSlot[]
  objectComponentGroups ObjectComponentGroup[] @relation("ObjectGroupFromScene")
}

model Choice {
  id          String @id @default(cuid())
  fromSceneId String @unique
  fromScene   Scene  @relation("FromScene", fields: [fromSceneId], references: [id], onDelete: Cascade)
  toSceneId   String @unique
  toScene     Scene  @relation("ToScene", fields: [toSceneId], references: [id], onDelete: Cascade)
  label       String // option text shown to player
  orderIndex  Int    @default(0)
}

//Project timeline
model Timeline {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation("ProjectTimeline", fields: [projectId], references: [id], onDelete: Cascade)
  actions   Action[]
}

//A group of components.
model ObjectComponentGroup {
  id               String            @id
  fromSceneId      String
  fromScene        Scene             @relation("ObjectGroupFromScene", fields: [fromSceneId], references: [id], onDelete: Cascade)
  objectComponents ObjectComponent[] @relation("GroupComponents")
}

//Component which is automatically paired to a group
model ObjectComponent {
  id                     String               @id
  title                  String
  objectComponentGroupId String
  objectComponentGroup   ObjectComponentGroup @relation("GroupComponents", fields: [objectComponentGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//Action of the timeline
model Action {
  id         String    @id @default(cuid())
  timeline   Timeline? @relation(fields: [timelineId], references: [id])
  timelineId String?
}

//Variable of the project
model Variable {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name]) //The combination has to be unique
}

model SaveSlot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId   String
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  slotIndex Int // 1-based slot number
  stateJson String? // snapshot of variables/flags as JSON
  createdAt DateTime @default(now())

  @@unique([projectId, slotIndex])
}
